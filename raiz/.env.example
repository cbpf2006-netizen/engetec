# =============================================================================
# Raiz — variáveis de ambiente
#
# Copie este arquivo para .env.local e preencha. Nenhuma chave secreta é usada
# pelo app: o isolamento entre usuários é feito pela RLS no Postgres, não por
# uma service role no servidor.
# =============================================================================

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Supabase → Project Settings → API Keys → publishable/anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Opcional. Endereço público do app, usado para montar os links de confirmação
# de conta e de recuperação de senha. Em desenvolvimento pode ficar vazio — o
# app usa o host da própria requisição. Na Vercel, defina com o domínio final:
# NEXT_PUBLIC_URL_DO_APP=https://raiz.vercel.app
NEXT_PUBLIC_URL_DO_APP=
